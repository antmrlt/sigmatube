<?xml version="1.0" encoding="utf-8"?>
<!-- Launch animation: the red block pops in, then the Σ grows and fades in. -->
<animated-vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt">
    <aapt:attr name="android:drawable">
        <vector
            android:width="108dp"
            android:height="108dp"
            android:viewportWidth="108"
            android:viewportHeight="108">
            <group
                android:name="logo"
                android:pivotX="54"
                android:pivotY="54"
                android:scaleX="0"
                android:scaleY="0">
                <path
                    android:fillColor="#FF0033"
                    android:pathData="M37,36 C48,35.4 60,35.4 71,36 C76,36.3 79.7,40 80,45 C80.4,51 80.4,57 80,63 C79.7,68 76,71.7 71,72 C60,72.6 48,72.6 37,72 C32,71.7 28.3,68 28,63 C27.6,57 27.6,51 28,45 C28.3,40 32,36.3 37,36 Z" />
                <group
                    android:name="sigma"
                    android:pivotX="54"
                    android:pivotY="54"
                    android:scaleX="0.3"
                    android:scaleY="0.3">
                    <path
                        android:name="sigmaPath"
                        android:fillAlpha="0"
                        android:fillColor="#FFFFFF"
                        android:pathData="M46.97,45.80 L61.03,45.80 L61.03,48.73 L51.43,48.73 L56.35,54.00 L51.43,59.27 L61.03,59.27 L61.03,62.20 L46.97,62.20 L46.97,59.85 L52.60,54.00 L46.97,48.15 Z" />
                </group>
            </group>
        </vector>
    </aapt:attr>

    <target android:name="logo">
        <aapt:attr name="android:animation">
            <set>
                <objectAnimator
                    android:duration="320"
                    android:interpolator="@android:interpolator/overshoot"
                    android:propertyName="scaleX"
                    android:valueFrom="0"
                    android:valueTo="1" />
                <objectAnimator
                    android:duration="320"
                    android:interpolator="@android:interpolator/overshoot"
                    android:propertyName="scaleY"
                    android:valueFrom="0"
                    android:valueTo="1" />
            </set>
        </aapt:attr>
    </target>

    <target android:name="sigma">
        <aapt:attr name="android:animation">
            <set>
                <objectAnimator
                    android:duration="300"
                    android:interpolator="@android:interpolator/overshoot"
                    android:propertyName="scaleX"
                    android:startOffset="200"
                    android:valueFrom="0.3"
                    android:valueTo="1" />
                <objectAnimator
                    android:duration="300"
                    android:interpolator="@android:interpolator/overshoot"
                    android:propertyName="scaleY"
                    android:startOffset="200"
                    android:valueFrom="0.3"
                    android:valueTo="1" />
            </set>
        </aapt:attr>
    </target>

    <target android:name="sigmaPath">
        <aapt:attr name="android:animation">
            <objectAnimator
                android:duration="200"
                android:propertyName="fillAlpha"
                android:startOffset="200"
                android:valueFrom="0"
                android:valueTo="1" />
        </aapt:attr>
    </target>
</animated-vector>
